# Modèle de configuration — copier en .env (non versionné) puis remplacer
# TOUTES les valeurs ci-dessous. Ne jamais commiter de vrais identifiants.

# Airflow (compte admin de l'interface web, aussi utilisé par Streamlit)
AIRFLOW_USER=change_me_user
AIRFLOW_PASSWORD=change_me_strong_password
AIRFLOW_EMAIL=you@example.com
